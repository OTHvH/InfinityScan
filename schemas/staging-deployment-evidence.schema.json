{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infinityscan.example/schemas/staging-deployment-evidence.schema.json",
  "title": "InfinityScan staging deployment evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "environment", "release_id", "git_sha", "publication_run_id",
    "api_reference", "web_reference", "started_at", "completed_at", "active_slot",
    "migration_revision_before", "migration_revision_after", "preflight", "smoke", "rollback_rehearsal"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "environment": { "const": "staging" },
    "release_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "publication_run_id": { "type": "string", "pattern": "^[0-9]+$" },
    "api_reference": { "type": "string", "pattern": "^ghcr\\.io/[^/@\\s]+/[^/@\\s]+@sha256:[0-9a-f]{64}$" },
    "web_reference": { "type": "string", "pattern": "^ghcr\\.io/[^/@\\s]+/[^/@\\s]+@sha256:[0-9a-f]{64}$" },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": { "type": "string", "format": "date-time" },
    "previous_release_id": { "type": ["string", "null"] },
    "active_slot": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
    "migration_revision_before": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "migration_revision_after": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "preflight": { "const": "passed" },
    "smoke": { "enum": ["passed", "rolled_back", "not-run"] },
    "rollback_rehearsal": { "enum": ["not-requested", "passed", "failed"] },
    "operator": { "type": "string", "pattern": "^[A-Za-z0-9@._:+/-]{1,160}$" }
  }
}
