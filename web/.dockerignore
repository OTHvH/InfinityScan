# ===========================================================================
# Web — Docker build context exclusions
# ===========================================================================

# Environment / secrets
.env
.env.*
**/.env
**/.env.*

# Node
node_modules/
.next/
out/
build/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Python virtual environments (should not exist here, but just in case)
.venv/
venv/
ENV/
env/

# TypeScript build info
*.tsbuildinfo

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS-generated files
.DS_Store
Thumbs.db

# Git metadata
.git/
.gitignore

# Documentation (not needed at runtime)
*.md

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Release and test artifacts
backups/
backup/
reports/
test-reports/
screenshots/
playwright-report/
test-results/
traces/
*.trace.zip
age-keys/
*.age
e2e/
tests/
__tests__/
