# Production template for a same-origin deployment. Every value in angle
# brackets must be replaced before use. Secret placeholders are intentionally
# shorter than the application's minimum and are not usable credentials.

APP_ENV=production
LOG_LEVEL=INFO

POSTGRES_USER=<replace>
POSTGRES_PASSWORD=<replace>
POSTGRES_DB=<replace>
DATABASE_URL=postgresql+psycopg://<user>:<password>@<database-host>:5432/<database-name>

JWT_SECRET_KEY=<replace>
CSRF_SECRET_KEY=<replace-separately>

COOKIE_SECURE=true
COOKIE_SAME_SITE=lax

TRUSTED_HOSTS=<public-hostname>
ALLOWED_ORIGINS=https://<public-hostname>
# Intentionally empty because the browser and API share one public origin.
CORS_ORIGINS=

OBJECT_STORAGE_ENABLED=false
# When enabled, replace every value below and set OBJECT_STORAGE_ENABLED=true.
S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=<bucket-name>
S3_ACCESS_KEY_ID=<replace>
S3_SECRET_ACCESS_KEY=<replace>
