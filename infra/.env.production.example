# Placeholder-only production deployment template. Replace every angle-bracket
# value in a protected environment file before deployment. This file contains
# no usable secret or image digest.

APP_ENV=production
APP_DOMAIN=app.example.com
ACME_EMAIL=<operator-email>
CADDY_IMAGE=ghcr.io/example/caddy@sha256:<64-hex-digest>
API_IMAGE=ghcr.io/example/infinityscan-api@sha256:<64-hex-digest>
WEB_IMAGE=ghcr.io/example/infinityscan-web@sha256:<64-hex-digest>

# Secrets are mounted from files outside the Git checkout.
DATABASE_URL_FILE=/etc/infinityscan/secrets/database_url
JWT_SECRET_KEY_FILE=/etc/infinityscan/secrets/jwt_secret_key
CSRF_SECRET_KEY_FILE=/etc/infinityscan/secrets/csrf_secret_key
S3_ACCESS_KEY_ID_FILE=/etc/infinityscan/secrets/s3_access_key_id
S3_SECRET_ACCESS_KEY_FILE=/etc/infinityscan/secrets/s3_secret_access_key
# Backup tooling only; not mounted into web or API containers.
# AGE_IDENTITY_FILE=/etc/infinityscan/secrets/age_identity

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_SSLMODE=verify-full
# Optional provider CA bundle, mounted separately if required.
# DB_SSLROOTCERT=/run/secrets/postgres_ca

COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
# Public host plus the private Compose service host used by Next.js rewrites.
TRUSTED_HOSTS=app.example.com,api
ALLOWED_ORIGINS=https://app.example.com
CORS_ORIGINS=
TRUST_FORWARDED_HEADERS=true
TRUSTED_PROXY_CIDRS=172.31.0.0/24
FORWARDED_HEADER_MAX_LENGTH=2048
FORWARDED_MAX_HOPS=5

OBJECT_STORAGE_ENABLED=true
S3_ENDPOINT_URL=https://<r2-account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=<private-application-bucket>
S3_FORCE_PATH_STYLE=false
S3_CONNECT_TIMEOUT=5
S3_READ_TIMEOUT=30
S3_MAX_RETRIES=4
S3_PRESIGN_TTL_SECONDS=300
MEDIA_CSP_ORIGINS=https://<r2-account-id>.r2.cloudflarestorage.com

NEXT_PUBLIC_API_URL=/api
API_INTERNAL_URL=http://api:8000
LOG_FORMAT=json
LOG_LEVEL=INFO
READINESS_CACHE_SECONDS=5
