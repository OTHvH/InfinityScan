# ===========================================================================
# InfinityScan - Local Development Environment
# ===========================================================================
# Copy this file only to infra/.env for local development and edit as needed.
#
#   cp infra/.env.example infra/.env
#
# These are synthetic development values, not production credentials. For
# production, use infra/.env.production.example as a placeholder-only checklist
# and replace every angle-bracket value in a protected environment source.
# ===========================================================================

# ---------------------------------------------------------------------------
# Application Environment
# ---------------------------------------------------------------------------

# Environment: development, staging, or production
APP_ENV=development

# Application name and version
APP_NAME=InfinityScan
APP_VERSION=0.2.0

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Development output is readable text. Production defaults to JSON.
LOG_FORMAT=text
READINESS_CACHE_SECONDS=5

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------

# Username for the Postgres instance.
POSTGRES_USER=changeme_user

# Password for the Postgres instance.
# IMPORTANT: Change this to a strong, unique password in any real environment.
POSTGRES_PASSWORD=changeme_password

# Name of the database to create.
POSTGRES_DB=changeme_db

# Full SQLAlchemy connection URL used by the API and Alembic migrations.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://changeme_user:changeme_password@db:5432/changeme_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000
# PostgreSQL TLS is required in production. SQLite tests ignore these options.
DB_SSLMODE=prefer
# DB_SSLROOTCERT=/path/to/provider-ca.pem

# Backup artifact directory and age encryption recipient. The recipient is
# public; never place an age private identity or database password here.
# BACKUP_DIR=/secure/backups
# AGE_RECIPIENT=age1...
# AGE_IDENTITY_FILE=/secure/age/restore-identity.txt

# ---------------------------------------------------------------------------
# JWT / Authentication
# ---------------------------------------------------------------------------

# HMAC signing key for JWTs. Compose requires an explicit value; the API only
# auto-generates one when run directly in development. REQUIRED in production.
JWT_SECRET_KEY=changeme_secret_key_at_least_32_chars

# CSRF signing key. Production requires this to be at least 32 bytes and
# different from JWT_SECRET_KEY.
CSRF_SECRET_KEY=changeme_distinct_csrf_secret_at_least_32_chars

# JWT algorithm (default: HS256)
JWT_ALGORITHM=HS256

# JWT issuer and audience (for token validation)
JWT_ISSUER=infinityscan
JWT_AUDIENCE=infinityscan

# Access token lifetime in minutes (default: 30)
ACCESS_TOKEN_TTL_MINUTES=30

# Refresh token lifetime in days (default: 30)
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------------------
# Cookies
# ---------------------------------------------------------------------------

# Cookie names (defaults shown)
# ACCESS_COOKIE_NAME=is_access
# REFRESH_COOKIE_NAME=is_refresh
# CSRF_COOKIE_NAME=is_csrf

# Cookie security settings
# Set to true in production (requires HTTPS)
COOKIE_SECURE=false

# SameSite policy: lax, strict, or none
# If set to 'none', COOKIE_SECURE must be true
COOKIE_SAME_SITE=lax

# Optional: Cookie domain (defaults to request domain)
# COOKIE_DOMAIN=.example.com

# Cookie path (default: /)
# COOKIE_PATH=/

# CSRF header name (default: x-csrf-token)
# CSRF_HEADER_NAME=x-csrf-token

# Refresh-session maintenance
# Retain revoked/expired sessions for this many days before cleanup.
SESSION_RETENTION_DAYS=30
# Maximum rows changed by one maintenance transaction.
SESSION_MAINTENANCE_BATCH_SIZE=500
# Retain audit events for this many days.
AUDIT_RETENTION_DAYS=365
# Maximum audit rows pruned by one command invocation.
AUDIT_PRUNE_BATCH_SIZE=500

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------

# Rate limit for registration endpoint (default: 5/minute)
REGISTER_RATE_LIMIT=5/minute

# Rate limit for login endpoint (default: 10/minute)
LOGIN_RATE_LIMIT=10/minute

# ---------------------------------------------------------------------------
# Password Policy
# ---------------------------------------------------------------------------

# Minimum password length (default: 8)
MIN_PASSWORD_LENGTH=8

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Browser traffic uses the same-origin Next.js /api proxy, so CORS is not needed.
# Set exact origins only for an intentional cross-origin client.
CORS_ORIGINS=

# Exact public origins accepted on unsafe requests.
ALLOWED_ORIGINS=http://localhost:3000

# Comma-separated list of trusted hosts
# Include the Compose service name used by the private Next.js proxy.
TRUSTED_HOSTS=localhost,127.0.0.1,api
TRUST_FORWARDED_HEADERS=false
TRUSTED_PROXY_CIDRS=
FORWARDED_HEADER_MAX_LENGTH=2048
FORWARDED_MAX_HOPS=5

# ---------------------------------------------------------------------------
# CopyManga upstream
# ---------------------------------------------------------------------------

# Optional: CopyManga API token (leave blank for anonymous access).
# COPYMANGA_TOKEN=

# CopyManga API base URL (default: https://api.copymanga.tv)
# COPYMANGA_API=https://api.copymanga.tv

# ---------------------------------------------------------------------------
# Object Storage / S3-compatible backend
# ---------------------------------------------------------------------------

# Disabled by default. Enable only after all required settings are configured.
# Credentials are consumed by the API server only and must never be exposed to the web client.
OBJECT_STORAGE_ENABLED=false

# S3-compatible endpoint. Leave blank for AWS S3; use http://minio:9000 in Compose.
# Production Cloudflare R2 deployments must set this and use S3_REGION=auto.
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=infinityscan-pages
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PRESIGN_TTL_SECONDS=300
S3_FORCE_PATH_STYLE=false
S3_CONNECT_TIMEOUT=5
S3_READ_TIMEOUT=30
S3_MAX_RETRIES=4

# Browser-visible image origins. Compose development uses the host gateway;
# production must use HTTPS provider/CDN origins in .env.production.
MEDIA_CSP_ORIGINS=http://host.docker.internal:*,http://127.0.0.1:*,http://localhost:*

# Integrity scanner bounds. FULL inventory pages never exceed 1000 objects.
INTEGRITY_MAX_CONCURRENCY=8
INTEGRITY_INVENTORY_PAGE_SIZE=1000
INTEGRITY_ISSUE_LIMIT=1000

# Explicit orphan deletion ignores newer objects to avoid import-finalization races.
INTEGRITY_DELETE_MIN_AGE_SECONDS=86400

# Optional public CDN base URL. Presigned URLs remain the default delivery mechanism.
STORAGE_PUBLIC_BASE_URL=

# Legacy cover prefix used by the current API response path.
# S3_PUBLIC_URL=https://cdn.example.com

# Local MinIO profile credentials and host ports.
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=change-me-locally
# MINIO_API_PORT=9000
# MINIO_CONSOLE_PORT=9001

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------

# Host the FastAPI server binds to.
API_HOST=0.0.0.0

# Port the FastAPI server listens on.
API_PORT=8000

# ---------------------------------------------------------------------------
# Web server (Next.js)
# ---------------------------------------------------------------------------

# Private origin used only by the Next.js server to proxy browser /api requests
# to unprefixed FastAPI routes. Standard Compose supplies http://api:8000 at
# build and runtime; standalone development defaults to http://localhost:8000.
# Never rename or duplicate this as NEXT_PUBLIC_* or reference it in client JS.
# API_INTERNAL_URL=http://api:8000
