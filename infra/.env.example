# Database
POSTGRES_USER=infinityscan
POSTGRES_PASSWORD=changeme
POSTGRES_DB=infinityscan
DATABASE_URL=postgresql+psycopg://infinityscan:changeme@db:5432/infinityscan

# API
API_HOST=0.0.0.0
API_PORT=8000

# Web
# NEXT_PUBLIC_API_URL is baked into the browser JS bundle at build time.
# It MUST be a URL reachable by end-user browsers, not a Docker-internal hostname.
# Local dev (without Docker):   http://localhost:8000
# Production:                   https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# CORS
# Comma-separated list of allowed origins (no spaces around commas).
# Default: http://localhost:3000 (Next.js dev server)
CORS_ORIGINS=http://localhost:3000
