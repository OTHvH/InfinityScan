# ===========================================================================
# API — Docker build context exclusions
# ===========================================================================

# Environment / secrets
.env
.env.*
**/.env
**/.env.*

# Python virtual environments
.venv/
venv/
ENV/
env/

# Python caches
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Local database files
*.db
*.sqlite
*.sqlite3

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS-generated files
.DS_Store
Thumbs.db

# Git metadata
.git/
.gitignore

# Documentation (not needed at runtime)
*.md
TEST_PLAN.md

# Local manga content
mangas/
manga/
comics/
content/
local_imports/
[0-9]*/

# Logs
*.log
